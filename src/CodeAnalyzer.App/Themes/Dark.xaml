<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="App.Background" Color="#1A1B1E" />
    <SolidColorBrush x:Key="App.Panel.Background" Color="#212327" />
    <SolidColorBrush x:Key="App.Panel.Border" Color="#33363B" />
    <SolidColorBrush x:Key="App.StatusBar.Background" Color="#17181B" />
    <SolidColorBrush x:Key="App.Splitter" Color="#2B2E33" />

    <!-- Text -->
    <SolidColorBrush x:Key="App.Foreground" Color="#E6E8EB" />
    <SolidColorBrush x:Key="App.Foreground.Muted" Color="#9098A3" />
    <SolidColorBrush x:Key="App.Foreground.Faint" Color="#6B7280" />

    <!-- Controls -->
    <SolidColorBrush x:Key="App.Control.Background" Color="#2A2D33" />
    <SolidColorBrush x:Key="App.Control.Border" Color="#3C4048" />
    <SolidColorBrush x:Key="App.Control.Hover" Color="#343840" />
    <SolidColorBrush x:Key="App.Control.Pressed" Color="#3E434C" />
    <SolidColorBrush x:Key="App.Selection.Background" Color="#2F4A6B" />

    <!-- Accent -->
    <SolidColorBrush x:Key="App.Accent" Color="#4C9AFF" />
    <SolidColorBrush x:Key="App.Accent.Foreground" Color="#0B1220" />

    <!-- Status -->
    <SolidColorBrush x:Key="App.Error" Color="#F2755C" />
    <SolidColorBrush x:Key="App.Warning" Color="#E0B341" />
    <SolidColorBrush x:Key="App.Success" Color="#5FD08A" />

    <!-- Symbol kind accents, mirrored by the graph page's CSS variables -->
    <SolidColorBrush x:Key="Kind.Function" Color="#7AA2F7" />
    <SolidColorBrush x:Key="Kind.Type" Color="#C39AF0" />
    <SolidColorBrush x:Key="Kind.Constant" Color="#E0AF68" />
    <SolidColorBrush x:Key="Kind.Variable" Color="#7DCFFF" />
    <SolidColorBrush x:Key="Kind.Module" Color="#9ECE6A" />
    <SolidColorBrush x:Key="Kind.Macro" Color="#F7768E" />

    <Color x:Key="App.BackgroundColor">#1A1B1E</Color>

</ResourceDictionary>
