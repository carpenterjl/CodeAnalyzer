<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Obsidian Syntax — dark theme (the brand's home).

        Values come from the design system's tokens/colors.css. Every key defined here is
        also defined in Light.xaml, so ThemeService can swap the whole dictionary without
        any consumer knowing which theme is live. Never hard-code a colour in a view: read
        a key and both themes follow.
    -->

    <!-- ============ Surfaces: the layered obsidian ramp ============ -->
    <SolidColorBrush x:Key="App.Background" Color="#0B1326" />
    <SolidColorBrush x:Key="App.Surface" Color="#0B1326" />
    <SolidColorBrush x:Key="App.Surface.Lowest" Color="#060D20" />
    <SolidColorBrush x:Key="App.Surface.Low" Color="#131B2E" />
    <SolidColorBrush x:Key="App.Surface.Container" Color="#171F33" />
    <SolidColorBrush x:Key="App.Surface.High" Color="#222A3E" />
    <SolidColorBrush x:Key="App.Surface.Highest" Color="#2D3449" />

    <!-- Panels are the low container; the toolbar sits one step above the canvas. -->
    <SolidColorBrush x:Key="App.Panel.Background" Color="#131B2E" />
    <SolidColorBrush x:Key="App.Panel.Background.Raised" Color="#171F33" />
    <SolidColorBrush x:Key="App.Panel.Background.Hover" Color="#222A3E" />
    <SolidColorBrush x:Key="App.Panel.Border" Color="#3D494C" />
    <SolidColorBrush x:Key="App.StatusBar.Background" Color="#060D20" />
    <SolidColorBrush x:Key="App.Splitter" Color="#222A3E" />
    <SolidColorBrush x:Key="App.Scrim" Color="#99060D20" />

    <!-- ============ Text ============ -->
    <SolidColorBrush x:Key="App.Foreground" Color="#DBE2FD" />
    <SolidColorBrush x:Key="App.Foreground.Muted" Color="#BCC9CD" />
    <SolidColorBrush x:Key="App.Foreground.Faint" Color="#869397" />
    <!-- Headings are off-white, never pure white and never cyan. -->
    <SolidColorBrush x:Key="App.Heading" Color="#E2E8F0" />

    <!-- ============ Controls ============ -->
    <SolidColorBrush x:Key="App.Control.Background" Color="#171F33" />
    <SolidColorBrush x:Key="App.Control.Border" Color="#3D494C" />
    <SolidColorBrush x:Key="App.Control.Hover" Color="#222A3E" />
    <SolidColorBrush x:Key="App.Control.Pressed" Color="#2D3449" />
    <SolidColorBrush x:Key="App.Selection.Background" Color="#1B3A4A" />

    <!-- ============ Accent: cyan, reserved for interaction ============ -->
    <SolidColorBrush x:Key="App.Accent" Color="#4CD7F6" />
    <SolidColorBrush x:Key="App.Accent.Solid" Color="#06B6D4" />
    <SolidColorBrush x:Key="App.Accent.Foreground" Color="#003640" />
    <SolidColorBrush x:Key="App.Accent.Subtle" Color="#1F4CD7F6" />
    <SolidColorBrush x:Key="App.Focus.Ring" Color="#4CD7F6" />
    <!-- The 2px focus glow: rgba(76,215,246,.45). -->
    <SolidColorBrush x:Key="App.Focus.Glow" Color="#734CD7F6" />

    <!-- Indigo marks navigation and terminal breadcrumb nodes. -->
    <SolidColorBrush x:Key="App.Nav.Accent" Color="#C0C1FF" />

    <!-- ============ Status ============ -->
    <SolidColorBrush x:Key="App.Error" Color="#FFB4AB" />
    <SolidColorBrush x:Key="App.Error.Container" Color="#93000A" />
    <SolidColorBrush x:Key="App.Warning" Color="#E0B341" />
    <SolidColorBrush x:Key="App.Success" Color="#4EDEA3" />

    <!-- ============ Symbol kinds ============ -->
    <!-- Carried over verbatim from the pre-Obsidian palette: these encode data, not chrome.
         Mirrored by the graph page's CSS variables. -->
    <SolidColorBrush x:Key="Kind.Function" Color="#7AA2F7" />
    <SolidColorBrush x:Key="Kind.Type" Color="#C39AF0" />
    <SolidColorBrush x:Key="Kind.Constant" Color="#E0AF68" />
    <SolidColorBrush x:Key="Kind.Variable" Color="#7DCFFF" />
    <SolidColorBrush x:Key="Kind.Module" Color="#9ECE6A" />
    <SolidColorBrush x:Key="Kind.Macro" Color="#F7768E" />
    <SolidColorBrush x:Key="Kind.Interface" Color="#2AC3A2" />

    <!-- ============ Code syntax ============ -->
    <!-- Read by CodePreviewBehavior for the AvalonEdit preview. -->
    <SolidColorBrush x:Key="Syntax.Keyword" Color="#4CD7F6" />
    <SolidColorBrush x:Key="Syntax.Function" Color="#4EDEA3" />
    <SolidColorBrush x:Key="Syntax.Type" Color="#C0C1FF" />
    <SolidColorBrush x:Key="Syntax.String" Color="#9ECE6A" />
    <SolidColorBrush x:Key="Syntax.Number" Color="#E0AF68" />
    <SolidColorBrush x:Key="Syntax.Comment" Color="#6B7A90" />
    <SolidColorBrush x:Key="Syntax.Punctuation" Color="#BCC9CD" />
    <SolidColorBrush x:Key="Syntax.Variable" Color="#DBE2FD" />
    <SolidColorBrush x:Key="Code.LineNumber" Color="#4A5570" />
    <SolidColorBrush x:Key="Code.LineActive" Color="#124CD7F6" />

    <!-- Colours, for the few consumers that cannot take a brush. -->
    <Color x:Key="App.BackgroundColor">#0B1326</Color>
    <Color x:Key="App.AccentColor">#4CD7F6</Color>

</ResourceDictionary>
