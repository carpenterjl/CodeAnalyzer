<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="App.Background" Color="#FBFBFC" />
    <SolidColorBrush x:Key="App.Panel.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Panel.Border" Color="#DFE2E7" />
    <SolidColorBrush x:Key="App.StatusBar.Background" Color="#F1F3F5" />
    <SolidColorBrush x:Key="App.Splitter" Color="#E4E7EB" />

    <!-- Text -->
    <SolidColorBrush x:Key="App.Foreground" Color="#1C1F23" />
    <SolidColorBrush x:Key="App.Foreground.Muted" Color="#5C6470" />
    <SolidColorBrush x:Key="App.Foreground.Faint" Color="#8A929E" />

    <!-- Controls -->
    <SolidColorBrush x:Key="App.Control.Background" Color="#F4F5F7" />
    <SolidColorBrush x:Key="App.Control.Border" Color="#D2D6DC" />
    <SolidColorBrush x:Key="App.Control.Hover" Color="#E9ECF0" />
    <SolidColorBrush x:Key="App.Control.Pressed" Color="#DDE1E6" />
    <SolidColorBrush x:Key="App.Selection.Background" Color="#CFE3FA" />

    <!-- Accent -->
    <SolidColorBrush x:Key="App.Accent" Color="#1A6FD4" />
    <SolidColorBrush x:Key="App.Accent.Foreground" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="App.Error" Color="#C0392B" />
    <SolidColorBrush x:Key="App.Warning" Color="#A9791C" />
    <SolidColorBrush x:Key="App.Success" Color="#237A48" />

    <!-- Symbol kind accents, mirrored by the graph page's CSS variables -->
    <SolidColorBrush x:Key="Kind.Function" Color="#2C5DBF" />
    <SolidColorBrush x:Key="Kind.Type" Color="#7A3FB5" />
    <SolidColorBrush x:Key="Kind.Constant" Color="#9A6712" />
    <SolidColorBrush x:Key="Kind.Variable" Color="#1B7A99" />
    <SolidColorBrush x:Key="Kind.Module" Color="#3F7A28" />
    <SolidColorBrush x:Key="Kind.Macro" Color="#C0395A" />

    <Color x:Key="App.BackgroundColor">#FBFBFC</Color>

</ResourceDictionary>
