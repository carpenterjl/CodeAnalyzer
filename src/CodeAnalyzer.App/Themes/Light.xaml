<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Obsidian Syntax — light theme.

        The same token names as Dark.xaml, re-valued: paper surfaces, and the brand accents
        darkened until they hold contrast on white. Nothing else changes — same layout, same
        spacing, same radii, same control templates. Values come from the design system's
        tokens/theme-light.css.
    -->

    <!-- ============ Surfaces ============ -->
    <SolidColorBrush x:Key="App.Background" Color="#FBFBFC" />
    <SolidColorBrush x:Key="App.Surface" Color="#FBFBFC" />
    <SolidColorBrush x:Key="App.Surface.Lowest" Color="#F1F3F5" />
    <SolidColorBrush x:Key="App.Surface.Low" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Surface.Container" Color="#F4F5F7" />
    <SolidColorBrush x:Key="App.Surface.High" Color="#E9ECF0" />
    <SolidColorBrush x:Key="App.Surface.Highest" Color="#DDE1E6" />

    <SolidColorBrush x:Key="App.Panel.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Panel.Background.Raised" Color="#F4F5F7" />
    <SolidColorBrush x:Key="App.Panel.Background.Hover" Color="#E9ECF0" />
    <SolidColorBrush x:Key="App.Panel.Border" Color="#DFE2E7" />
    <SolidColorBrush x:Key="App.StatusBar.Background" Color="#F1F3F5" />
    <SolidColorBrush x:Key="App.Splitter" Color="#E4E7EB" />
    <SolidColorBrush x:Key="App.Scrim" Color="#99111826" />

    <!-- ============ Text ============ -->
    <SolidColorBrush x:Key="App.Foreground" Color="#1C1F23" />
    <SolidColorBrush x:Key="App.Foreground.Muted" Color="#5C6470" />
    <SolidColorBrush x:Key="App.Foreground.Faint" Color="#8A929E" />
    <SolidColorBrush x:Key="App.Heading" Color="#111826" />

    <!-- ============ Controls ============ -->
    <SolidColorBrush x:Key="App.Control.Background" Color="#F4F5F7" />
    <SolidColorBrush x:Key="App.Control.Border" Color="#DFE2E7" />
    <SolidColorBrush x:Key="App.Control.Hover" Color="#E9ECF0" />
    <SolidColorBrush x:Key="App.Control.Pressed" Color="#DDE1E6" />
    <SolidColorBrush x:Key="App.Selection.Background" Color="#CFE3FA" />

    <!-- ============ Accent ============ -->
    <SolidColorBrush x:Key="App.Accent" Color="#0E7490" />
    <SolidColorBrush x:Key="App.Accent.Solid" Color="#0891B2" />
    <SolidColorBrush x:Key="App.Accent.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Accent.Subtle" Color="#1F0891B2" />
    <SolidColorBrush x:Key="App.Focus.Ring" Color="#0891B2" />
    <!-- rgba(8,145,178,.28) -->
    <SolidColorBrush x:Key="App.Focus.Glow" Color="#470891B2" />

    <SolidColorBrush x:Key="App.Nav.Accent" Color="#4A4BAB" />

    <!-- ============ Status ============ -->
    <SolidColorBrush x:Key="App.Error" Color="#C0392B" />
    <SolidColorBrush x:Key="App.Error.Container" Color="#FFDAD6" />
    <SolidColorBrush x:Key="App.Warning" Color="#A9791C" />
    <SolidColorBrush x:Key="App.Success" Color="#0F7A52" />

    <!-- ============ Symbol kinds ============ -->
    <SolidColorBrush x:Key="Kind.Function" Color="#2C5DBF" />
    <SolidColorBrush x:Key="Kind.Type" Color="#7A3FB5" />
    <SolidColorBrush x:Key="Kind.Constant" Color="#9A6712" />
    <SolidColorBrush x:Key="Kind.Variable" Color="#1B7A99" />
    <SolidColorBrush x:Key="Kind.Module" Color="#3F7A28" />
    <SolidColorBrush x:Key="Kind.Macro" Color="#C0395A" />
    <SolidColorBrush x:Key="Kind.Interface" Color="#0D8A70" />

    <!-- ============ Code syntax ============ -->
    <SolidColorBrush x:Key="Syntax.Keyword" Color="#0E7490" />
    <SolidColorBrush x:Key="Syntax.Function" Color="#0F7A52" />
    <SolidColorBrush x:Key="Syntax.Type" Color="#5A3FB5" />
    <SolidColorBrush x:Key="Syntax.String" Color="#3F7A28" />
    <SolidColorBrush x:Key="Syntax.Number" Color="#9A6712" />
    <SolidColorBrush x:Key="Syntax.Comment" Color="#78828F" />
    <SolidColorBrush x:Key="Syntax.Punctuation" Color="#5C6470" />
    <SolidColorBrush x:Key="Syntax.Variable" Color="#1C1F23" />
    <SolidColorBrush x:Key="Code.LineNumber" Color="#A7AEBB" />
    <SolidColorBrush x:Key="Code.LineActive" Color="#120891B2" />

    <Color x:Key="App.BackgroundColor">#FBFBFC</Color>
    <Color x:Key="App.AccentColor">#0891B2</Color>

</ResourceDictionary>
