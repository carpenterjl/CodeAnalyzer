<Window x:Class="CodeAnalyzer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodeAnalyzer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsDialogViewModel}"
        Title="Workspace settings"
        Width="480" Height="460"
        MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="IGNORED DIRECTORIES" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="8,0,8,6"
                       Text="Directory names skipped on top of the built-in rules (.git, bin, obj, node_modules, …). One name per line — names, not paths. Applies on the next re-index." />

            <TextBox Grid.Row="1" Margin="8,0,8,4"
                     Text="{Binding IgnoreText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource App.MonoFontFamily}"
                     VerticalContentAlignment="Top" />
        </Grid>

        <TextBlock Grid.Row="2" Text="FILE SIZE CAP" Style="{StaticResource SectionHeader}" Margin="0,12,0,2" />

        <StackPanel Grid.Row="3" Margin="8,0,8,0">
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Files larger than this are skipped — anything this big is almost always generated or vendored." />
            <StackPanel Orientation="Horizontal">
                <TextBox Width="90" Text="{Binding MaxFileSizeMbText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource App.Foreground}" />
            </StackPanel>
            <TextBlock Text="{Binding SizeCapError}"
                       Foreground="{DynamicResource App.Warning}"
                       Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Visibility="{Binding SizeCapError, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save and re-index" Click="OnAccept" IsDefault="True" Padding="10,4" />
            <Button Content="Cancel" IsCancel="True" Padding="10,4" Margin="6,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
